# ==========================================
# WeatherGPT Environment Variables Template
# Copy this file to .env.local and fill in your keys
# ==========================================

# ==========================================
# CORE REQUIRED
# ==========================================
# AUTH_SESSION_SECRET: Must be >= 32 chars. 
# Breaks: User sessions and app authentication if missing or invalid.
# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=

# AUTH_DATA_ENCRYPTION_KEY: Must be valid base64, >= 32 bytes when decoded.
# Breaks: User data encryption (accounts/incidents) if missing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_DATA_ENCRYPTION_KEY=

# ==========================================
# OPTIONAL FEATURES
# ==========================================
# WEATHER (Open-Meteo is public and is the live default)
# Default API is https://api.open-meteo.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# GOOGLE_API_KEY: Used for Google weather/geocoding enrichment.
# Generate at: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_API_KEY=

# OPENWEATHERMAP_API_KEY: Used for fallback weather data.
# Generate at: https://home.openweathermap.org/api_keys
OPENWEATHERMAP_API_KEY=

# IMD_API_KEY: Not consumed currently.
IMD_API_KEY=
# WAQI_API_TOKEN: Not consumed currently.
WAQI_API_TOKEN=

# ==========================================
# WEB PUSH (All 3 required for Web Push)
# ==========================================
# Breaks: Push subscriptions and notifications if missing or partially configured.
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ==========================================
# SMS/TWILIO (All 3 required for SMS)
# ==========================================
# Breaks: SMS delivery and OTP if missing or partially configured.
# TWILIO_ACCOUNT_SID must start with 'AC'
# Generate at: Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ==========================================
# AI PROVIDERS (Optional, features degrade to fallback if missing)
# ==========================================
# GEMINI_API_KEY: Required for Google Gemini features. Non-empty string.
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CLAUDE_API_KEY: Required for Anthropic Claude features. Non-empty string.
# Generate at: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# OPENAI_API_KEY: Required for OpenAI features. Non-empty string.
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OLLAMA
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==========================================
# DATABASE (Optional)
# ==========================================
# MONGODB_URI: Required for accounts, incidents, subscriptions.
# Must start with mongodb:// or mongodb+srv://
# Breaks: Data persistence. Will use in-memory fallback.
MONGODB_URI=

# ==========================================
# ML & MISC (Optional)
# ==========================================
# LOCAL / EDGE ML (Python + ml/requirements.txt are required for live model inference)
PYTHON_BIN=
HEAVY_RAIN_THRESHOLD_MM=20
HEAVY_RAIN_PROBABILITY=70
RAIN_ALERT_LOOKAHEAD_HOURS=12
RAIN_ALERT_COOLDOWN_HOURS=6

# EMAIL
EMAIL_USER=
EMAIL_PASS=

# CRON
CRON_SECRET=

# ADMIN
ADMIN_API_KEY=
